---
/**
 * Copied from {@link https://docs.astro.build/en/recipes/i18n/#let-users-switch-between-languages}.
 * Needs adjusting?
 */
import { languages } from "../i18n/ui";
---

<ul>
  {
    Object.entries(languages).map(([lang, label]) => (
      <li>
        <a href={`/${lang}/`}>{label}</a>
      </li>
    ))
  }
</ul>